rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Rules for the "users" collection
    match /users/{userId} {
      // Anyone can read user profiles, but only the owner can write to their own profile
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Rules for the "posts" collection
    match /posts/{postId} {
      // Anyone logged in can read posts
      allow read: if request.auth != null;
      
      // Create: User must be logged in and the 'userId' field in the post data must match their UID
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid;
      
      // Update: Either the post owner is changing it, OR someone is liking/unliking it
      allow update: if request.auth != null && (
        // Case A: The owner edits the post content
        request.resource.data.userId == request.auth.uid 
        ||
        // Case B: A different user is only modifying the 'likedBy' array (ignoring other fields)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']))
      );

      // Delete: Only the original creator of the post can delete it
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
  }
}
